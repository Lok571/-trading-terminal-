Step 1: The Core Data Provider


import asyncio
import aiohttp
from typing import Dict, Any, List

class MarketDataEngine:
    """Core SDK engine for fetching market data asynchronously."""
    
    def __init__(self):
        self.session = None

    async def initialize(self):
        if not self.session:
            self.session = aiohttp.ClientSession()

    async def close(self):
        if self.session:
            await self.session.close()

    async def fetch_ticker(self, symbol: str) -> Dict[str, Any]:
        """Fetches the latest live price and 24h stats for a symbol."""
        # Example using a public, no-auth crypto API (Binance)
        url = f"https://api.binance.com/api/v3/ticker/24hr?symbol={symbol.upper()}"
        async with self.session.get(url) as response:
            if response.status == 200:
                data = await response.json()
                return {
                    "symbol": symbol.upper(),
                    "last_price": float(data.get("lastPrice", 0.0)),
                    "price_change_pct": float(data.get("priceChangePercent", 0.0)),
                    "volume": float(data.get("volume", 0.0))
                }
            raise Exception(f"Failed to fetch ticker data: {response.status}")




Step 2: The Core Visual App




from textual.app import App, ComposeResult
from textual.widgets import Header, Footer, Static
from textual.containers import Container, Grid
from termitrade_core.data_provider import MarketDataEngine

class TradingTerminalApp(App):
    """The primary user interface wrapper running in the terminal."""
    
    CSS = """
    Grid {
        grid-size: 2;
        grid-rows: 1fr;
        padding: 1;
    }
    .panel {
        border: solid green;
        background: $surface;
        padding: 1;
        alignment: center middle;
    }
    """
    
    BINDINGS = [
        ("q", "quit", "Quit Terminal"),
        ("r", "refresh", "Refresh Prices")
    ]

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Grid():
            yield Static("Loading live symbol updates...", id="ticker-view", classes="panel")
            yield Static("Historical Candlestick Chart (Placeholder)", id="chart-view", classes="panel")
        yield Footer()

    async def on_mount(self) -> None:
        """Runs immediately when the application interface initializes."""
        self.engine = MarketDataEngine()
        await self.engine.initialize()
        await self.update_market_data()

    async def action_refresh(self) -> None:
        """Manual refresh action triggered by the 'R' key."""
        await self.update_market_data()

    async def update_market_data(self) -> None:
        """Queries the engine and pushes the new values safely to the visual widgets."""
        try:
            # Defaults to BTCUSDT for a seamless out-of-the-box demo
            data = await self.engine.fetch_ticker("BTCUSDT")
            ticker_widget = self.query_one("#ticker-view", Static)
            
            ticker_widget.update(
                f"[bold cyan]Asset Engine Live[/bold cyan]\n\n"
                f"Symbol: [yellow]{data['symbol']}[/yellow]\n"
                f"Last Price: [green]${data['last_price']:,}[/green]\n"
                f"24h Change: {data['price_change_pct']}%"
            )
        except Exception as e:
            self.query_one("#ticker-view", Static).update(f"[red]Error: {str(e)}[/red]")

    async def on_unmount(self) -> None:
        """Guarantees underlying background network processes close cleanly."""
        await self.engine.close()

if __name__ == "__main__":
    app = TradingTerminalApp()
    app.run()



